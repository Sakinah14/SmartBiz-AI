# Copy this file to .env and fill in real values.
# Never commit the actual .env file.

PORT=5000
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret

# Gemini AI (used by /api/ai)
GEMINI_API_KEY=your_gemini_api_key

# Password reset emails (Resend)
# RESEND_API_KEY: an API key from https://resend.com/api-keys (requires a free Resend account)
RESEND_API_KEY=your_resend_api_key

# Base URL(s) of the running frontend. Used to build the password-reset link
# AND as the CORS allow-list — only these origins may call this API.
# Comma-separate multiple origins (e.g. staging + production).
FRONTEND_URL=http://localhost:5173
